{
  "name": "w2p",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env W2P_DATA_DIR=.data-test tsx --test --test-concurrency=1 \"src/modules/**/__tests__/*.test.ts\"",
    "test:integration": "cross-env W2P_DATA_DIR=.data-test tsx --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "seed": "tsx src/modules/seed/seed.ts",
    "test:e2e": "playwright test --project=desktop",
    "test:e2e:all": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "framer-motion": "^12.4.7",
    "konva": "^10.9.1",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "nodemailer": "^6.9.16",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "19.0.10",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
