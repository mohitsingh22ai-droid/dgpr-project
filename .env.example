# ==============================================================================
# W2P web-to-print platform — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel: Project → Settings → Environment Variables.
# ==============================================================================

# Supabase (Settings → API Keys). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Public URL of the site (used for Stripe return URLs and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (test keys in development). Webhook endpoint: /api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional email. Emails go to the customer's registered address.
# EMAIL_PROVIDER: resend | smtp | test (test only records emails, sends nothing)
#  - resend: needs a domain verified in Resend and EMAIL_FROM on that domain
#    (onboarding@resend.dev can only deliver to your own Resend login email)
#  - smtp:   e.g. Gmail (SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#            SMTP_PASS=<Google app password>, EMAIL_FROM=you@gmail.com)
EMAIL_PROVIDER=resend
EMAIL_FROM=orders@your-verified-domain.in
RESEND_API_KEY=re_...
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: send every email to one address instead of the customer (development only)
EMAIL_SANDBOX_MODE=false
EMAIL_SANDBOX_RECIPIENT=

# GST: seller registration (07 = Delhi). Same-state deliveries get CGST+SGST, others IGST.
SELLER_STATE_CODE=07
NEXT_PUBLIC_SELLER_STATE_CODE=07
SELLER_GSTIN=
SELLER_LEGAL_NAME=W2P Print House
SELLER_ADDRESS=New Delhi, Delhi, India

# Optional: dedicated secret for signed download tokens (defaults to a hash of the service key)
SIGNED_URL_SECRET=
